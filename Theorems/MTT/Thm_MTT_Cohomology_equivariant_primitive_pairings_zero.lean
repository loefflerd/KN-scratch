  have hz₁ := MTT.sum_integral_wirtinger_smul_fd_eq_zero
    (Γ := CongruenceSubgroup.Gamma1 N) hR hA₁ hinv₁ hdecay₁ hint₁
  have hz₂ := MTT.sum_integral_wirtinger_smul_fd_eq_zero
    (Γ := CongruenceSubgroup.Gamma1 N) hR hA₂ hinv₂ hdecay₂ hint₂
