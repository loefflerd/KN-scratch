/-!
# Units in a finite p-group algebra are detected by augmentation

Theorem statement: `MonoidAlgebra.isUnit_iff_augmentation_of_isPGroup_v2`
(`f4cf573e-e3bc-4a40-8854-9d2ac723769d`), by davidloeffler, 2026-09-21.

Proof: submission `ebf6a977-8d7d-487c-960a-92f4c2800e70`, by davidloeffler, 2026-09-21 (ACCEPTED);
locally adapted.

For a finite commutative p-group G over a commutative local ring R of residue characteristic p, an
element of R[G] is a unit if and only if its augmentation is a unit in R.

## Explanation of the source proof

Use the local-ring structure on R[G] supplied by `MonoidAlgebra.isLocalRing_of_isPGroup`. The
augmentation is surjective, since a coefficient is the augmentation of the corresponding term
supported at the identity. Mathlib therefore makes augmentation a local homomorphism between local
rings, and `isUnit_map_iff` says exactly that it reflects and preserves units. The uploaded theorem
is at `_root_.solution`.

<!-- Generated by add_prove2me_provenance.py -->
-/

noncomputable section privateSection

/-- In the group ring of a finite `p`-group over a commutative local ring of
residue characteristic `p`, an element is a unit exactly when its augmentation
is a unit. This is the augmentation corollary of
`MonoidAlgebra.isLocalRing_of_isPGroup`. -/
theorem solution
    {R G : Type*} [CommRing R] [IsLocalRing R]
    {p : ℕ} [Fact p.Prime] [CommGroup G] [Finite G]
    (hp : (p : R) ∈ IsLocalRing.maximalIdeal R)
    (hG : IsPGroup p G) (x : MonoidAlgebra R G) :
    IsUnit x ↔ IsUnit (MonoidAlgebra.augmentation R G x) := by
  have := MonoidAlgebra.isLocalRing_of_isPGroup hp hG
  let aug := MonoidAlgebra.augmentation R G
  have hsurj : Function.Surjective aug := by
    intro r
    refine ⟨MonoidAlgebra.single 1 r, ?_⟩
    simp [aug, MonoidAlgebra.augmentation]
  have : IsLocalHom aug := IsLocalHom.of_surjective aug hsurj
  exact (isUnit_map_iff aug x).symm

end privateSection

public noncomputable section publicSection

/-- In the group ring of a finite `p`-group over a commutative local ring of
residue characteristic `p`, an element is a unit exactly when its augmentation
is a unit. This is the augmentation corollary of
`MonoidAlgebra.isLocalRing_of_isPGroup`. -/
theorem MonoidAlgebra.isUnit_iff_augmentation_of_isPGroup_v2
    {R G : Type*} [CommRing R] [IsLocalRing R]
    {p : ℕ} [Fact p.Prime] [CommGroup G] [Finite G]
    (hp : (p : R) ∈ IsLocalRing.maximalIdeal R)
    (hG : IsPGroup p G) (x : MonoidAlgebra R G) :
    IsUnit x ↔ IsUnit (MonoidAlgebra.augmentation R G x) :=
  solution hp hG x

end publicSection
