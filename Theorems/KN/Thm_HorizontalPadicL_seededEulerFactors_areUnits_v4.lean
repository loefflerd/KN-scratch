/-!
# Euler factors in the clean faithful theta system are units

Theorem statement: `HorizontalPadicL.seededEulerFactors_areUnits_v4`
(`7a4359c1-3712-40a6-a424-5f75c98e156f`), by davidloeffler, 2026-09-25.

Proof: submission `18a293ae-8716-4717-a810-733c789c7003`, by davidloeffler, 2026-09-25 (ACCEPTED);
locally adapted.

Every Euler factor in the faithful finite theta system is a unit. Its augmentation has norm one by
the orderly-prime condition, and the finite p-group group-algebra unit criterion lifts this to the
Euler factor itself.

This is the clean-spine replacement used to remove deprecated definition bundles from the live
graph.

## Explanation of the source proof

For each transition Euler factor, its augmentation is the orderly-prime scalar. The defining orderly
congruence and integrality put the nonconstant contribution in the maximal ideal, while the
remaining term has norm one, so the augmentation is a unit. The finite \(p\)-group augmentation
criterion then shows that the group-ring Euler factor itself is a unit.

<!-- Generated by add_prove2me_provenance.py -->
-/

section privateSection

noncomputable section

open HorizontalPadicL

set_option linter.unusedVariables false in
theorem solution
    {N k p B : ℕ} {ι : MTT.Qbar →+* ℂ} [Fact p.Prime]
    (f : MTT.Eigenform N k ι) (hnew : IsNewEigenform f)
    (η : DirichletCharacterWithLevel) (ιp : MTT.Qbar →+* ℂ_[p])
    (L : SeededHorizontalPrimeDataV3 p ιp f η B)
    (Θ : SeededFiniteThetaDataV3 L) :
    Θ.HasUnitEulerFactors := by
  intro A n
  rcases Θ with ⟨R, hR, hintegral, characters, theta, eulerFactor, haug⟩
  subst R
  apply horizontalGroupAlgebra_isUnit_of_augmentation_norm_one_v2 L.exponent A
  calc
    ‖((horizontalAugmentation (eulerFactor A n) :
        (𝓞_ℂ_[p]).toSubring) : ℂ_[p])‖ =
        ‖ιp (η.2 (L.primeAt n) * f.coeff (L.primeAt n) -
          (η.2 (L.primeAt n)) ^ 2 - f.epsilon (L.primeAt n))‖ := haug A n
    _ = 1 := (L.primeAt_orderly n).2.2.2
end

end privateSection

public section publicSection

noncomputable section

namespace HorizontalPadicL

/-- The orderly-prime calculation makes every Euler factor in the faithful
theta system a unit. -/
theorem seededEulerFactors_areUnits_v4
    {N k p B : ℕ} {ι : MTT.Qbar →+* ℂ} [Fact p.Prime]
    (f : MTT.Eigenform N k ι) (hnew : IsNewEigenform f)
    (η : DirichletCharacterWithLevel) (ιp : MTT.Qbar →+* ℂ_[p])
    (L : SeededHorizontalPrimeDataV3 p ιp f η B)
    (Θ : SeededFiniteThetaDataV3 L) :
    Θ.HasUnitEulerFactors := _root_.solution f hnew η ιp L Θ

end HorizontalPadicL
end

end publicSection
