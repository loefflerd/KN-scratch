/-!
# The rational prime belongs to the selected coefficient prime

Theorem statement: `MTT.Eigenform.p_mem_coefficientPrime` (`b8db3c01-54d3-4082-897d-a1bb59c2ad90`),
by davidloeffler, 2026-09-20.

Proof: submission `06aabbbb-346c-4a50-a1f5-d82d9ecd08fc`, by davidloeffler, 2026-09-20 (ACCEPTED);
locally adapted.

Let $f$ be an MTT eigenform and let
$\iota_p:\overline{\mathbf Q}\hookrightarrow\mathbf C_p$ select the prime
$\lambda_{\iota_p}$ of its coefficient field. Then the rational integer $p$
belongs to $\lambda_{\iota_p}$.

## Explanation of the source proof

By `mem_coefficientPrime_iff`, membership is equivalent to strict p-adic norm less than one. The
norm on `C_p` extends the norm on `Q_p`, and `Padic.norm_p_lt_one` gives the result. The uploaded
theorem is at `_root_.solution`.

<!-- Generated by add_prove2me_provenance.py -->
-/

section privateSection

noncomputable section

open NumberField

theorem solution
    {N k p : ℕ} {ι : MTT.Qbar →+* ℂ} [Fact p.Prime]
    (f : MTT.Eigenform N k ι) (ιp : MTT.Qbar →+* ℂ_[p]) :
    (p : 𝓞 f.coefficientField) ∈ f.coefficientPrime ιp := by
  rw [f.mem_coefficientPrime_iff ιp]
  have hp := Padic.norm_p_lt_one (p := p)
  have hext : ‖(p : ℂ_[p])‖ = ‖(p : ℚ_[p])‖ := by
    simpa using PadicComplex.norm_extends' p (p : ℚ_[p])
  simpa using hext.trans_lt hp
end

end privateSection

public section publicSection

noncomputable section

open NumberField

/-- The rational prime `p` belongs to the coefficient-field prime selected by
a `p`-adic embedding. -/
theorem MTT.Eigenform.p_mem_coefficientPrime
    {N k p : ℕ} {ι : MTT.Qbar →+* ℂ} [Fact p.Prime]
    (f : MTT.Eigenform N k ι) (ιp : MTT.Qbar →+* ℂ_[p]) :
    (p : 𝓞 f.coefficientField) ∈ f.coefficientPrime ιp := _root_.solution f ιp
end

