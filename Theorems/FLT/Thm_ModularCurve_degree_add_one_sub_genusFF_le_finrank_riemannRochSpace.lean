    (D : Divisor (AlgebraicClosure ℚ) (modularFunctionFieldBar N)) :
    D.degree + 1 - (genusFF (AlgebraicClosure ℚ) (modularFunctionFieldBar N) : ℤ)
      ≤ (Module.finrank (AlgebraicClosure ℚ) ↥(riemannRochSpace D) : ℤ) := by
