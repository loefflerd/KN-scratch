        + W.veluGx x₀ y₀
          * ((W.toAffine.addX x₁ x₂ (W.toAffine.slope x₁ x₂ y₁ y₂) - x₀) * (y₂ - y₀)
              - (x₂ - x₀)
                * (W.toAffine.negAddY x₁ x₂ y₁ (W.toAffine.slope x₁ x₂ y₁ y₂) - y₀))
      = 0 := _root_.P2MW.S_WeierstrassCurve_velu2_secant_negAddY_cleared_identity.solution hP₁ hP₂ hQ hord hx12

end publicSection
