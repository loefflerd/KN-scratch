module

public import Definitions.MTT.Def_MTT_ParabolicCohomology

/-!
# Translation-normalized parabolic cocycles and their cohomology classes

Definition: `MTT_NormalizedParabolicCocycles` (`8f169573-cdf3-49ea-866b-2b3807914c1c`), by
cbirkbeck, 2026-09-07.

Let $N,n$ be natural numbers, let $V_n=\operatorname{Sym}^n(\mathbf C^2)$ carry the MTT left action
of $\Gamma_1(N)$, and put $T=\left(\begin{smallmatrix}1&1\\0&1\end{smallmatrix}\right)$. The
translation belongs to every $\Gamma_1(N)$. Define the subspace of normalized parabolic cocycles by

$$Z^1_{\mathrm{par},T}(\Gamma_1(N),V_n)=\{c\in Z^1_{\mathrm{par}}(\Gamma_1(N),V_n):c(T)=0\}.$$

The canonical linear map from this space to $H^1_{\mathrm{par}}(\Gamma_1(N),V_n)$ sends a cocycle to
its class modulo principal cocycles. These definitions isolate the translation-normalization step in
the MTT dimension argument. No surjectivity or dimension assertion is part of the definition.

<!-- Generated by add_prove2me_provenance.py -->
-/

@[expose] public section publicSection

/-! # Translation-normalized parabolic cocycles -/

noncomputable section

namespace MTT.Cohomology

/-- The standard translation belongs to every Gamma1(N). -/
def gammaOneT (N : ℕ) : CongruenceSubgroup.Gamma1 N :=
  ⟨ModularGroup.T, by
    rw [CongruenceSubgroup.Gamma1_mem]
    norm_num [ModularGroup.T]⟩

/-- Parabolic cocycles normalized to vanish on the standard translation. -/
def normalizedParabolic (N n : ℕ) : Submodule ℂ (parabolicCocycles N n) :=
  LinearMap.ker ((LinearMap.proj (gammaOneT N)).comp (parabolicCocycles N n).subtype)

/-- The canonical map from normalized representatives to parabolic cohomology. -/
def normalizedToH1 (N n : ℕ) : normalizedParabolic N n →ₗ[ℂ] ParabolicH1 N n :=
  (parabolicCoboundaries N n).mkQ.comp (normalizedParabolic N n).subtype

end MTT.Cohomology


end

end publicSection
