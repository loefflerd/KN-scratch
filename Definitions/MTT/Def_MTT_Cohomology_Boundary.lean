/-!
# Boundary symbols: $\Gamma_1(N)$-equivariant cusp data and their boundary cochains

Definition: `MTT_Cohomology_Boundary` (`b5d1eacb-2041-494f-a2eb-c9d59e4bb9a0`), by cbirkbeck,
2026-09-06.

Let $\Gamma=\Gamma_1(N)$ and $n\ge0$. A **boundary datum** is a $\Gamma$-equivariant function
$\Phi:\mathbf P^1(\mathbf Q)\to\operatorname{Sym}^n(R^2)$ on the cusps, i.e. an element of
$\operatorname{Hom}_\Gamma(\operatorname{Div}(\mathbf P^1(\mathbf Q)),\operatorname{Sym}^n R^2)$.
Its **boundary cochain** is the restriction along $\operatorname{Div}^0\subset\operatorname{Div}$,

$$
(\partial\Phi)(x,y)=\Phi(y)-\Phi(x),
$$

with the pair $(x,y)$ representing the degree-zero divisor $[x]-[y]$, matching the orientation of
the cusp-to-cusp integration cochain. The boundary cochains form the boundary summand
$\mathrm{BSymb}_\Gamma(V_n)$ of the space of modular symbols: in the Ash–Stevens long exact sequence
they are the image of $H^0(\Gamma,\operatorname{Hom}(\operatorname{Div},V_n))\to H^1_c(\Gamma,V_n)$,
and Eichler–Shimura identifies them with the Eisenstein contribution. They are the terms that must
be excluded from a cuspidal eigenpacket.

<!-- Generated by add_prove2me_provenance.py -->
-/

@[expose] public section publicSection

noncomputable section
open scoped BigOperators
namespace MTT.Cohomology

/-- The data of a boundary symbol: a `Γ₁(N)`-equivariant `Sym^n`-valued function on cusps,
i.e. an element of `Hom_Γ(Div(P¹(ℚ)), Sym^n(R²))`. -/
def IsBoundaryDatum (N n : ℕ) {R : Type*} [CommRing R] (Φ : Cusp → Binary R) : Prop :=
  (∀ x, Φ x ∈ Sym R n) ∧
  ∀ γ : CongruenceSubgroup.Gamma1 N, ∀ x, Φ (cuspAct γ.val x) = act γ.val.val (Φ x)

/-- The boundary cochain of `Φ`: the restriction of `Φ` along `Div⁰ ⊂ Div`,
`(x, y) ↦ Φ y − Φ x`, with `(x, y)` representing `[x] − [y]`. -/
def boundaryCochain {R : Type*} [CommRing R] (Φ : Cusp → Binary R) :
    (Cusp × Cusp) → Binary R :=
  fun D => Φ D.2 - Φ D.1

end MTT.Cohomology

end

end publicSection
